{
  "name": "Saturday Edge",
  "short_name": "Sat Edge",
  "description": "Multi-sport spread analysis with smart bet-slip import, international basketball tracking, cloud ledger, and result settlement",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#07100c",
  "theme_color": "#07100c",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "sharedTitle",
      "text": "sharedText",
      "files": [
        {
          "name": "betSlipImage",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp"
          ]
        }
      ]
    }
  }
}